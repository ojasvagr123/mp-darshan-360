{
  "name": "mp-darshan-360-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:generate": "prisma generate --schema prisma/schema.sqlite.prisma",
    "db:init": "node prisma/init-sqlite.mjs",
    "db:push": "prisma db push --schema prisma/schema.sqlite.prisma",
    "db:seed": "node prisma/seed.js",
    "db:generate:prod": "prisma generate --schema prisma/schema.postgres.prisma",
    "db:push:prod": "prisma db push --schema prisma/schema.postgres.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "prisma": "^6.14.0",
    "sgsits-virtual-campus": "file:../..",
    "zod": "^4.0.17"
  }
}
